{
  "name": "touchqr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "db:migrate": "node server/scripts/migrate_production_postgres.js",
    "db:migrate:dry-run": "node server/scripts/migrate_production_postgres.js --dry-run",
    "db:migrate:audit-indexes": "node server/scripts/migrate_audit_logs_indexes.js",
    "db:migrate:audit-indexes:dry-run": "node server/scripts/migrate_audit_logs_indexes.js --dry-run",
    "db:migrate:audit-indexes:rollback": "node server/scripts/migrate_audit_logs_indexes.js --rollback",
    "db:migrate:archival": "node server/scripts/migrate_audit_log_archival.js",
    "db:migrate:archival:dry-run": "node server/scripts/migrate_audit_log_archival.js --dry-run",
    "db:migrate:archival:rollback": "node server/scripts/migrate_audit_log_archival.js --rollback",
    "bootstrap:superadmin": "node server/scripts/bootstrap_superadmin.js",
    "start": "node server/index.js",
    "test": "node server/tests/run_all_tests.js",
    "test:ci": "node server/tests/run_all_tests.js --ci"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "vite": "^6.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
